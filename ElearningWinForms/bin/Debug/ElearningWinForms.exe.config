<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <add key="OtpPepper" value="CHANGE_ME_OTP_PEPPER" />
    <!-- Email dùng để gửi OTP + thông báo (Gmail + App Password). 
         Có thể set bằng env var để tránh commit secret:
         ELEARNING_SYSTEM_EMAIL và ELEARNING_SYSTEM_EMAIL_APP_PASSWORD -->
    <add key="SystemEmail" value="elearning.demoing@gmail.com" />
    <add key="SystemEmailAppPassword" value="dkve qxvo pcyc jajy" />
  </appSettings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>